

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard â€” EduPath</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy:   #0d1b2a;
      --blue:   #1a5f9c;
      --sky:    #3a9fd6;
      --accent: #f4a825;
      --light:  #f0f6fc;
      --white:  #ffffff;
      --text:   #1e2d3d;
      --muted:  #6b849a;
      --border: #d5e5f0;
      --success:#2e9b6e;
      --error:  #e53935;
      --sidebar:220px;
    }

    body { font-family: 'Sora', sans-serif; background: var(--light); color: var(--text); display: flex; min-height: 100vh; }

    /* â”€â”€ SIDEBAR â”€â”€ */
    .sidebar {
      width: var(--sidebar); flex-shrink: 0;
      background: var(--navy);
      display: flex; flex-direction: column;
      position: fixed; top: 0; left: 0; height: 100vh;
      z-index: 50; overflow-y: auto;
    }
    .sidebar-logo {
      padding: 1.5rem 1.5rem 1rem;
      font-family: 'DM Serif Display', serif;
      font-size: 2.2rem; letter-spacing: -0.5px; color: var(--white);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      text-decoration: none; display: block;
    }
    .sidebar-logo span { color: var(--sky); }

    .sidebar-user {
      padding: 1.1rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex; align-items: center; gap: 0.75rem;
    }
    .user-avatar {
      width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
      background: linear-gradient(135deg, var(--sky), var(--blue));
      display: flex; align-items: center; justify-content: center;
      font-size: 0.85rem; font-weight: 700; color: white;
    }
    .user-name  { font-size: 0.82rem; font-weight: 600; color: var(--white); }
    .user-class { font-size: 0.72rem; color: rgba(255,255,255,0.4); margin-top: 1px; }

    .sidebar-nav { flex: 1; padding: 1rem 0; }
    .nav-section { padding: 0 1rem 0.5rem 1.25rem; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.25); margin-top: 0.75rem; }
    .nav-item {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.65rem 1.5rem; cursor: pointer;
      font-size: 0.83rem; color: rgba(255,255,255,0.5);
      transition: all 0.2s; text-decoration: none;
      border-left: 3px solid transparent;
    }
    .nav-item:hover { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.85); }
    .nav-item.active { background: rgba(58,159,214,0.12); color: var(--white); border-left-color: var(--sky); font-weight: 600; }
    .nav-icon { font-size: 1rem; width: 18px; text-align: center; }
    .nav-badge { margin-left: auto; background: var(--sky); color: white; font-size: 0.65rem; font-weight: 700; padding: 1px 7px; border-radius: 20px; }

    .sidebar-footer {
      padding: 1rem 1.5rem;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .logout-btn {
      display: flex; align-items: center; gap: 0.6rem;
      font-size: 0.82rem; color: rgba(255,255,255,0.4);
      cursor: pointer; transition: color 0.2s; text-decoration: none;
    }
    .logout-btn:hover { color: var(--error); }

    /* â”€â”€ MAIN â”€â”€ */
    .main { margin-left: var(--sidebar); flex: 1; display: flex; flex-direction: column; min-height: 100vh; }

    /* TOP BAR */
    .topbar {
      background: var(--white); border-bottom: 1px solid var(--border);
      padding: 0 2rem; height: 60px;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 40;
    }
    .topbar-left h2 { font-size: 1rem; font-weight: 700; color: var(--navy); }
    .topbar-left p  { font-size: 0.75rem; color: var(--muted); }
    .topbar-right { display: flex; align-items: center; gap: 1rem; }
    .notif-btn {
      width: 34px; height: 34px; border-radius: 8px;
      background: var(--light); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 0.9rem; position: relative;
    }
    .notif-dot { width: 8px; height: 8px; background: var(--error); border-radius: 50%; position: absolute; top: 5px; right: 5px; }
    .btn-take-test {
      background: var(--navy); color: white;
      padding: 0.45rem 1rem; border-radius: 7px;
      font-size: 0.8rem; font-weight: 600;
      text-decoration: none; transition: background 0.2s;
    }
    .btn-take-test:hover { background: var(--blue); }

    /* PAGE CONTENT */
    .page-content { padding: 2rem; flex: 1; }

    /* TABS */
    .tabs { display: flex; gap: 0; border-bottom: 2px solid var(--border); margin-bottom: 2rem; }
    .tab {
      padding: 0.65rem 1.25rem; font-size: 0.83rem; font-weight: 600;
      color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent;
      margin-bottom: -2px; transition: all 0.2s;
    }
    .tab:hover { color: var(--navy); }
    .tab.active { color: var(--sky); border-bottom-color: var(--sky); }

    /* TAB PANELS */
    .tab-panel { display: none; animation: fadeUp 0.3s ease; }
    .tab-panel.active { display: block; }
    @keyframes fadeUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

    /* â”€â”€ OVERVIEW TAB â”€â”€ */
    .metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    .metric-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.25rem;
    }
    .metric-label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.5rem; }
    .metric-value { font-family: 'DM Serif Display', serif; font-size: 2rem; color: var(--navy); line-height: 1; }
    .metric-sub { font-size: 0.72rem; color: var(--muted); margin-top: 0.3rem; }
    .metric-change { font-size: 0.72rem; font-weight: 600; margin-top: 0.3rem; }
    .up { color: var(--success); } .down { color: var(--error); }

    /* Two col layout */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
    .three-col { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }

    /* Section card */
    .section-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.5rem;
    }
    .section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .section-head h3 { font-size: 0.9rem; font-weight: 700; color: var(--navy); }
    .section-head a { font-size: 0.75rem; color: var(--sky); text-decoration: none; }
    .section-head a:hover { text-decoration: underline; }

    /* Recommendation card */
    .rec-banner {
      background: linear-gradient(135deg, var(--navy), var(--blue));
      border-radius: 14px; padding: 1.75rem;
      color: white; margin-bottom: 1.5rem;
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap;
      position: relative; overflow: hidden;
    }
    .rec-banner::before {
      content: ''; position: absolute; right: -60px; top: -60px;
      width: 200px; height: 200px;
      background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
      border-radius: 50%;
    }
    .rec-tag  { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sky); margin-bottom: 0.4rem; }
    .rec-name { font-family: 'DM Serif Display', serif; font-size: 1.6rem; color: white; margin-bottom: 0.4rem; }
    .rec-desc { font-size: 0.82rem; color: rgba(255,255,255,0.55); line-height: 1.6; max-width: 420px; }
    .rec-careers-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
    .rec-pill { font-size: 0.7rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.8); }
    .rec-score { text-align: right; flex-shrink: 0; }
    .rec-score-num { font-family: 'DM Serif Display', serif; font-size: 3rem; color: var(--accent); line-height: 1; }
    .rec-score-label { font-size: 0.72rem; color: rgba(255,255,255,0.4); margin-top: 4px; }

    /* Score bars */
    .score-bars { display: flex; flex-direction: column; gap: 0.85rem; }
    .sbar-row { }
    .sbar-label { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text); margin-bottom: 0.35rem; font-weight: 600; }
    .sbar-track { height: 8px; background: var(--light); border-radius: 10px; overflow: hidden; }
    .sbar-fill  { height: 100%; border-radius: 10px; transition: width 1s ease; }

    /* Test history */
    .test-history { display: flex; flex-direction: column; gap: 0.75rem; }
    .test-row {
      display: flex; align-items: center; gap: 1rem;
      padding: 0.85rem 1rem; border-radius: 10px;
      background: var(--light); border: 1px solid var(--border);
    }
    .test-icon { font-size: 1.2rem; width: 36px; height: 36px; border-radius: 8px; background: var(--white); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); flex-shrink: 0; }
    .test-info { flex: 1; }
    .test-name { font-size: 0.83rem; font-weight: 600; color: var(--navy); }
    .test-date { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }
    .test-score { font-size: 0.85rem; font-weight: 700; color: var(--sky); }
    .test-badge { font-size: 0.68rem; font-weight: 700; padding: 2px 9px; border-radius: 20px; }
    .badge-done  { background: rgba(46,155,110,0.1); color: var(--success); }
    .badge-new   { background: rgba(244,168,37,0.12); color: #b07a00; }

    /* Quick actions */
    .quick-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .qa-btn {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.85rem 1rem; border-radius: 10px;
      border: 1.5px solid var(--border); background: var(--white);
      cursor: pointer; transition: all 0.2s; text-decoration: none;
    }
    .qa-btn:hover { border-color: var(--sky); background: #f0f8ff; transform: translateY(-1px); }
    .qa-icon { font-size: 1.2rem; }
    .qa-text { font-size: 0.8rem; font-weight: 600; color: var(--navy); }
    .qa-sub  { font-size: 0.7rem; color: var(--muted); margin-top: 1px; }

    /* â”€â”€ SAVED COLLEGES TAB â”€â”€ */
    .saved-grid { display: flex; flex-direction: column; gap: 1rem; }
    .college-row {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.25rem 1.5rem;
      display: grid; grid-template-columns: 1fr auto;
      align-items: center; gap: 1rem;
      transition: box-shadow 0.2s;
    }
    .college-row:hover { box-shadow: 0 4px 20px rgba(13,27,42,0.08); }
    .cr-name { font-size: 0.95rem; font-weight: 700; color: var(--navy); margin-bottom: 0.25rem; }
    .cr-loc  { font-size: 0.78rem; color: var(--muted); margin-bottom: 0.6rem; }
    .cr-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .cr-tag  { font-size: 0.68rem; font-weight: 600; padding: 2px 9px; border-radius: 20px; }
    .t-blue  { background: rgba(58,159,214,0.1);  color: var(--blue); }
    .t-green { background: rgba(46,155,110,0.1);  color: var(--success); }
    .t-amber { background: rgba(244,168,37,0.12); color: #b07a00; }
    .cr-stats { display: flex; gap: 1.5rem; margin-top: 0.75rem; }
    .cr-stat-val { font-size: 0.88rem; font-weight: 700; color: var(--navy); }
    .cr-stat-key { font-size: 0.68rem; color: var(--muted); }
    .cr-actions { display: flex; gap: 0.5rem; }
    .btn-remove {
      font-size: 0.75rem; padding: 0.4rem 0.9rem; border-radius: 7px;
      border: 1.5px solid var(--border); background: transparent;
      color: var(--muted); cursor: pointer; font-family: 'Sora', sans-serif;
      transition: all 0.2s;
    }
    .btn-remove:hover { border-color: var(--error); color: var(--error); }

    /* â”€â”€ PROFILE TAB â”€â”€ */
    .profile-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; }
    .profile-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 14px; padding: 2rem; text-align: center;
    }
    .profile-avatar {
      width: 72px; height: 72px; border-radius: 50%;
      background: linear-gradient(135deg, var(--sky), var(--blue));
      display: flex; align-items: center; justify-content: center;
      font-size: 1.6rem; font-weight: 700; color: white;
      margin: 0 auto 1rem;
    }
    .profile-name { font-family: 'DM Serif Display', serif; font-size: 1.3rem; color: var(--navy); margin-bottom: 0.25rem; }
    .profile-email { font-size: 0.8rem; color: var(--muted); margin-bottom: 1rem; }
    .profile-badge { display: inline-block; background: rgba(58,159,214,0.1); color: var(--blue); font-size: 0.72rem; font-weight: 700; padding: 3px 12px; border-radius: 20px; margin-bottom: 1.5rem; }
    .profile-divider { height: 1px; background: var(--border); margin: 1rem 0; }
    .profile-stat { margin-bottom: 0.75rem; }
    .ps-label { font-size: 0.72rem; color: var(--muted); }
    .ps-value { font-size: 0.88rem; font-weight: 600; color: var(--navy); margin-top: 2px; }

    .form-card { background: var(--white); border: 1px solid var(--border); border-radius: 14px; padding: 1.75rem; }
    .form-card h3 { font-size: 0.9rem; font-weight: 700; color: var(--navy); margin-bottom: 1.25rem; }
    .form-row-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .form-grp { margin-bottom: 1rem; }
    .form-grp label { display: block; font-size: 0.78rem; font-weight: 600; color: var(--text); margin-bottom: 0.4rem; }
    .form-grp input, .form-grp select {
      width: 100%; padding: 0.65rem 0.85rem;
      border: 1.5px solid var(--border); border-radius: 8px;
      font-family: 'Sora', sans-serif; font-size: 0.85rem; color: var(--text);
      outline: none; transition: border-color 0.2s;
    }
    .form-grp input:focus, .form-grp select:focus { border-color: var(--sky); }
    .btn-save-profile {
      background: var(--navy); color: white; border: none;
      padding: 0.7rem 1.75rem; border-radius: 8px;
      font-family: 'Sora', sans-serif; font-size: 0.88rem; font-weight: 600;
      cursor: pointer; transition: background 0.2s;
    }
    .btn-save-profile:hover { background: var(--blue); }
    .save-msg { display: none; font-size: 0.78rem; color: var(--success); margin-left: 0.75rem; font-weight: 600; }
    .save-msg.show { display: inline; }

    /* â”€â”€ NOTIFICATIONS â”€â”€ */
    .notif-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .notif-item {
      display: flex; gap: 1rem; padding: 1rem;
      border-radius: 10px; border: 1px solid var(--border);
      background: var(--white);
    }
    .notif-item.unread { background: #f0f8ff; border-color: rgba(58,159,214,0.2); }
    .notif-dot-wrap { width: 10px; padding-top: 5px; flex-shrink: 0; }
    .ndot { width: 8px; height: 8px; border-radius: 50%; background: var(--sky); }
    .notif-title { font-size: 0.83rem; font-weight: 600; color: var(--navy); margin-bottom: 0.2rem; }
    .notif-msg   { font-size: 0.78rem; color: var(--muted); line-height: 1.5; }
    .notif-time  { font-size: 0.7rem; color: var(--muted); margin-top: 0.4rem; }

    @media (max-width: 900px) {
      .sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
      .sidebar.active { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,0.1); }
      .main { margin-left: 0; }
      .mobile-menu-btn { display: block !important; background: none; border: none; font-size: 1.5rem; cursor: pointer; padding: 0.5rem; margin-right: 0.5rem; }
      .metric-grid { grid-template-columns: 1fr 1fr; }
      .two-col, .three-col, .profile-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
      .metric-grid { grid-template-columns: 1fr 1fr; }
      .quick-actions { grid-template-columns: 1fr; }
      .page-content { padding: 1.25rem; }
    }
  
</style>

</head>
<body>

<div class="sidebar">
  <a class="sidebar-logo" href="/">Edu<span>Path</span></a>

  <div class="sidebar-user">
    <div class="user-avatar"></div>
    <div>
      <div class="user-name"></div>
      <div class="user-class"></div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">Main</div>
    <a class="nav-item active" onclick="switchTab('overview', this)">
      <span class="nav-icon">ðŸ“Š</span> Overview
    </a>
    
    
    <div class="nav-section">Account</div>
    <a class="nav-item" onclick="switchTab('profile', this)">
      <span class="nav-icon">ðŸ‘¤</span> My Profile
    </a>
    <a class="nav-item" onclick="switchTab('notifications', this)">
      <span class="nav-icon">ðŸ””</span> Notifications
      <span class="nav-badge"></span>
    </a>
    <div class="nav-section">Pages</div>
    
    
  </nav>

  <div class="sidebar-footer">
    <a class="logout-btn" href="/logout">
      <span>â¬…</span> Logout
    </a>
  </div>
</div>

<div class="main">

  <div class="topbar">
    <div class="topbar-left" style="display: flex; align-items: center;">
      <button class="mobile-menu-btn" onclick="toggleSidebar()" style="display:none;">â˜°</button>
      <div>
        <h2 id="topbarTitle">Overview</h2>
        <p id="topbarSub">Welcome back,  ðŸ‘‹ ðŸ‘‹</p>
      </div>
    </div>
    <div class="topbar-right">


      <div class="notif-btn" onclick="switchTabByName('notifications')">
        ðŸ””
      </div>
      
    </div>
  </div>

  <div class="page-content">

    <div class="tabs">
      <div class="tab active" id="tab-overview"       onclick="switchTab('overview', this)">Overview</div>
      
      
      <div class="tab"        id="tab-profile"         onclick="switchTab('profile', this)">Profile</div>
      <div class="tab"        id="tab-notifications"   onclick="switchTab('notifications', this)">Notifications</div>
    </div>

    <div class="tab-panel active" id="panel-overview">

      <div class="metric-grid">
        
      </div>

      

      

      

      

      <div class="three-col">
        

        <div class="section-card">
          <div class="section-head"><h3>Quick Actions</h3></div>
          <div class="quick-actions">
            
            
            <a class="qa-btn" onclick="switchTabByName('profile')">
              <span class="qa-icon">ðŸ‘¤</span>
              <div><div class="qa-text">Edit Profile</div><div class="qa-sub">% remaining</div></div>
            </a>
          </div>
        </div>
      </div>

      
    </div>

    <div class="tab-panel" id="panel-test">
      <div class="section-card" style="margin-bottom:1.5rem;">
        <div class="section-head"><h3>Test History</h3><a href="/aptitude-test">+ New Test</a></div>
        <div class="test-history">
          
        </div>
      </div>
      
    </div>

    <div class="tab-panel" id="panel-saved">
      <div class="saved-grid">
        
      </div>
    </div>

    <div class="tab-panel" id="panel-profile">
      <div class="profile-grid">
        <div class="profile-card">
          <div class="profile-avatar"></div>
          <div class="profile-name"></div>
          <div class="profile-email"></div>
          <div class="profile-badge"></div>
          <div class="profile-divider"></div>
          <div class="profile-stat"><div class="ps-label">Stream</div><div class="ps-value"></div></div>
          <div class="profile-stat"><div class="ps-label">State</div><div class="ps-value"></div></div>
          <div class="profile-stat"><div class="ps-label">Member Since</div><div class="ps-value"></div></div>
          <div class="profile-divider"></div>
          <div style="margin-top:0.5rem;">
            <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--muted);margin-bottom:0.4rem;">
              <span>Profile Completion</span><span style="font-weight:700;color:var(--navy);">%</span>
            </div>
            <div style="height:6px;background:var(--border);border-radius:10px;overflow:hidden;">
              <div style="width:%;height:100%;background:var(--success);border-radius:10px;"></div>
            </div>
          </div>
        </div>

        <form class="form-card" action="/updateProfile" method="post">
          <h3>Edit Profile</h3>
          <div class="form-row-grid">
            <div class="form-grp">
              <label>First Name</label>
              <input type="text" name="firstName" value="" required />
            </div>
            <div class="form-grp">
              <label>Last Name</label>
              <input type="text" name="lastName" value="" required />
            </div>
          </div>
          <div class="form-grp">
            <label>Email Address</label>
            <input type="email" value="" disabled />
          </div>
          <div class="form-grp">
            <label>Mobile Number</label>
            <input type="tel" name="mobile" value="" />
          </div>
          <div class="form-row-grid">
            <div class="form-grp">
              <label>Class</label>
              <select name="userClass">
                <option value="10" >Class 10</option>
                <option value="12" >Class 12</option>
              </select>
            </div>
            <div class="form-grp">
              <label>Stream</label>
              <select name="stream">
                <option value="Science (PCM)" >Science (PCM)</option>
                <option value="Science (PCB)" >Science (PCB)</option>
                <option value="Commerce" >Commerce</option>
                <option value="Arts / Humanities" >Arts / Humanities</option>
              </select>
            </div>
          </div>
          <div class="form-row-grid">
            <div class="form-grp">
              <label>State</label>
              <select name="state">
                <option value="Madhya Pradesh" >Madhya Pradesh</option>
                <option value="Maharashtra" >Maharashtra</option>
                <option value="Delhi" >Delhi</option>
                <option value="Karnataka" >Karnataka</option>
              </select>
            </div>
            <div class="form-grp">
              <label>Category</label>
              <select name="category">
                <option value="General" >General</option>
                <option value="OBC" >OBC</option>
                <option value="SC/ST" >SC/ST</option>
              </select>
            </div>
          </div>
          <div class="form-row-grid">
            <div class="form-grp">
              <label>Target Entrance Exam</label>
              <select name="targetExam">
                <option value="">None / Not Decided</option>
                <option value="JEE Mains" >JEE Mains</option>
                <option value="NEET" >NEET</option>
                <option value="CUET" >CUET</option>
                <option value="CLAT" >CLAT</option>
              </select>
            </div>
            <div class="form-grp">
              <label>Expected Exam Score / Rank</label>
              <input type="number" name="expectedExamScore" value="" placeholder="e.g. 150 or 5000" />
            </div>
          </div>
          <div class="form-row-grid">
            <div class="form-grp">
              <label>Last Exam Percentage (12th / Board)</label>
              <input type="number" name="percentage" step="0.1" min="0" max="100" value="" placeholder="e.g. 87.5" />
            </div>
          </div>
          <button type="submit" class="btn-save-profile">Save Changes</button>
        </form>
      </div>
    </div>

