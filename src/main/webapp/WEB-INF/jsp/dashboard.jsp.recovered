<div id="chatWidget" style="position:fixed; bottom:2rem; right:2rem; z-index:9999; font-family:'Sora', sans-serif;">
  
  <!-- Chat Button -->
  <button id="chatToggle" onclick="toggleChat()" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #7c3aed, #4f46e5); color:white; border:none; box-shadow:0 8px 24px rgba(79,70,229,0.4); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1.8rem; transition:transform 0.2s;">
    âœï¸Â¨
  </button>

  <!-- Chat Window -->
  <div id="chatWindow" style="display:none; position:absolute; bottom:80px; right:0; width:350px; height:500px; background:var(--white); border-radius:16px; box-shadow:0 12px 40px rgba(0,0,0,0.15); border:1px solid var(--border); flex-direction:column; overflow:hidden;">
    <div style="background:linear-gradient(135deg, #7c3aed, #4f46e5); color:white; padding:1.2rem; display:flex; justify-content:space-between; align-items:center;">
      <div>
        <div style="font-weight:700; font-size:1.1rem; display:flex; align-items:center; gap:0.5rem;">âœï¸Â¨ ðŸ’¬ Ask EduPath AI</div>
        <div style="font-size:0.75rem; opacity:0.8;">Your personal college counselor</div>
      </div>
      <button onclick="toggleChat()" style="background:none; border:none; color:white; cursor:pointer; font-size:1.5rem; line-height:1;">&times;</button>
    </div>
    
    <div id="chatMessages" style="flex:1; padding:1.2rem; overflow-y:auto; background:var(--light); display:flex; flex-direction:column; gap:1rem;">
      <div style="background:var(--white); border:1px solid var(--border); padding:0.8rem 1rem; border-radius:12px; border-top-left-radius:0; align-self:flex-start; max-width:85%; font-size:0.9rem; line-height:1.4; color:var(--text);">
        Hi ! ðŸ‘‹ I can help you find colleges, understand exams, or compare options. Ask me anything!
      </div>
    </div>
    
    <form onsubmit="sendChatMessage(event)" style="padding:1rem; background:var(--white); border-top:1px solid var(--border); display:flex; gap:0.5rem;">
      <input type="text" id="chatInput" placeholder="Type a message..." required style="flex:1; padding:0.8rem; border:1px solid var(--border); border-radius:8px; outline:none; font-family:'Sora', sans-serif;" />
      <button type="submit" style="background:var(--sky); color:white; border:none; border-radius:8px; padding:0 1rem; cursor:pointer; font-weight:600;">Send</button>
    </form>
  </div>
</div>

<script>
  const chatWindow = document.getElementById('chatWindow');
  const chatToggle = document.getElementById('chatToggle');

  function toggleChat() {
    if (chatWindow.style.display === 'none') {
      chatWindow.style.display = 'flex';
      chatToggle.style.transform = 'scale(0.9)';
    } else {
      chatWindow.style.display = 'none';
      chatToggle.style.transform = 'scale(1)';
    }
  }

  async function sendChatMessage(e) {
    e.preventDefault();
    const input = document.getElementById('chatInput');
    const msg = input.value.trim();
    if (!msg) return;

    const msgsDiv = document.getElementById('chatMessages');
    
    // Add User Message
    msgsDiv.innerHTML += '<div style="background:var(--sky); color:white; padding:0.8rem 1rem; border-radius:12px; border-bottom-right-radius:0; align-self:flex-end; max-width:85%; font-size:0.9rem; line-height:1.4;">' + msg + '</div>';
    input.value = '';
    msgsDiv.scrollTop = msgsDiv.scrollHeight;

    // Add Loading Indicator
    const loadId = 'load_' + Date.now();
    msgsDiv.innerHTML += '<div id="'+loadId+'" style="background:var(--white); border:1px solid var(--border); padding:0.8rem 1rem; border-radius:12px; border-top-left-radius:0; align-self:flex-start; font-size:0.9rem; color:var(--muted);">Thinking...</div>';
    msgsDiv.scrollTop = msgsDiv.scrollHeight;

    try {
      const response = await fetch('/api/chat/ask', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({message: msg})
      });
      const data = await response.json();
      
      document.getElementById(loadId).remove();

      if (response.ok) {
        msgsDiv.innerHTML += '<div style="background:var(--white); border:1px solid var(--border); padding:0.8rem 1rem; border-radius:12px; border-top-left-radius:0; align-self:flex-start; max-width:85%; font-size:0.9rem; line-height:1.4; color:var(--text);">' + data.reply.replace(/\\n/g, '<br>') + '</div>';
      } else {
        msgsDiv.innerHTML += '<div style="background:rgba(229,57,53,0.1); color:var(--error); padding:0.8rem 1rem; border-radius:12px; border-top-left-radius:0; align-self:flex-start; max-width:85%; font-size:0.9rem; line-height:1.4;">' + (data.error || 'Failed to get response') + '</div>';
      }
    } catch (err) {
      document.getElementById(loadId).remove();
      msgsDiv.innerHTML += '<div style="color:var(--error); font-size:0.9rem; align-self:center;">Connection error.</div>';
    }
    msgsDiv.scrollTop = msgsDiv.scrollHeight;
  }
</script>
