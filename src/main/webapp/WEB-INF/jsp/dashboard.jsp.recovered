  <!-- AI Strategy Modal -->
  <div id="strategyModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:var(--white); padding:2rem; border-radius:12px; max-width:600px; width:90%; max-height:80vh; overflow-y:auto; position:relative;">
      <button onclick="document.getElementById('strategyModal').style.display='none'" style="position:absolute; top:1rem; right:1.5rem; background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--muted);">&times;</button>
      <h2 style="font-family:'DM Serif Display', serif; color:var(--navy); margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
        <span style="font-size:1.5rem;">âœï¸Â¨</span> Your AI Admission Strategy
      </h2>
      <div id="strategyContent" style="color:var(--text); line-height:1.6; font-size:0.95rem;">
        <div style="text-align:center; padding:2rem;">
          <div style="animation: spin 1s linear infinite; display:inline-block; font-size:2rem; margin-bottom:1rem;">â³</div>
          <p>Gemini AI is analyzing your profile...</p>
        </div>
      </div>
    </div>
  </div>
  <style>@keyframes spin { 100% { transform: rotate(360deg); } }
</style>

  <script>
      const tabMeta = {
    overview:      { title: 'Overview',         sub: `Welcome back,  👋` },
    test:          { title: 'My Tests',          sub: 'Track your aptitude progress' },
    saved:         { title: 'Saved Colleges',    sub: 'Your college shortlist' },
    profile:       { title: 'My Profile',        sub: 'Manage your account details' },
    notifications: { title: 'Notifications',     sub: 'Stay updated' },
  };

  function switchTab(name, el) {
    // Panels
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    var panel = document.getElementById('panel-' + name);
    if(panel) panel.classList.add('active');

    // Tabs
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    var tab = document.getElementById('tab-' + name);
    if(tab) tab.classList.add('active');

    // Sidebar
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    if (el) el.classList.add('active');

    // Topbar
    if (tabMeta[name]) {
      var titleEl = document.getElementById('topbarTitle');
      var subEl = document.getElementById('topbarSub');
      if(titleEl) titleEl.textContent = tabMeta[name].title;
      if(subEl) subEl.textContent = tabMeta[name].sub;
    }

    // Animate bars on overview
    if (name === 'overview') animateBars();
  }

  function switchTabByName(name) {
    const tab = document.getElementById('tab-' + name);
    switchTab(name, tab);
  }

  function animateBars() {
    setTimeout(() => {
      
    }, 200);
  }

  function markAllRead() {
    document.querySelectorAll('.notif-item.unread').forEach(n => {
      n.classList.remove('unread');
      const dot = n.querySelector('.ndot');
      if (dot) dot.remove();
    });
    document.getElementById('topbarSub').textContent = 'All caught up ðŸ‘';
  }

  function deleteAccount() {
    if(confirm("Are you sure you want to delete your account? This action cannot be undone.")) {
      window.location.href = "/logout";
    }
  }

  function toggleSidebar() {
    document.querySelector('.sidebar').classList.toggle('active');
  }

  // Animate bars on load
  animateBars();

  async function generateAIStrategy(e) {
    e.preventDefault();
    const modal = document.getElementById('strategyModal');
    const content = document.getElementById('strategyContent');
    
    modal.style.display = 'flex';
    content.innerHTML = '<div style="text-align:center; padding:2rem;"><div style="animation: spin 1s linear infinite; display:inline-block; font-size:2rem; margin-bottom:1rem;">â³</div><p>Gemini AI is analyzing your profile...</p></div>';

    try {
      const response = await fetch('/api/strategy/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const data = await response.json();
      
      if (response.ok) {
        content.innerHTML = data.strategyHtml;
      } else {
        content.innerHTML = '<div style="color:var(--error); padding:1rem; background:rgba(229,57,53,0.1); border-radius:8px;">' + (data.error || 'An error occurred') + '</div>';
      }
    } catch (err) {
      content.innerHTML = '<div style="color:var(--error);">Failed to connect to the server.</div>';
    }
  }
  }
</script>

<!-- EduPath AI Chat Widget -->


</body>
</html>


